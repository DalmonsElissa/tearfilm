  "deviations": [
    {
      "area": "persistence operator",
      "id": "D01",
      "justification": "The sign test is piecewise constant in the derivative and therefore has zero gradient almost everywhere. A relaxation is the only way to train the three-term objective end to end, and the gap between the two evaluators is measured in execution check E52.",
      "manuscript_location": "Sec. 5.4, Algorithm 1 line 9",
      "released_behaviour": "Two evaluators are released. The hard evaluator applies the sign test as written and produces every reported descriptor. The soft evaluator replaces the sign-equality indicator with a sigmoid of the consecutive derivative product so that the integrated objective has a gradient; training uses it and inference does not."
    },
    {
      "area": "affected-area fraction",
      "id": "D02",
      "justification": "The article names alpha but does not print a value. The default is bounded above by the smallest peak affected fraction the case table reports (0.36), because a declaration cannot follow its own peak.",
      "manuscript_location": "Sec. 5.4, the threshold alpha",
      "released_behaviour": "alpha defaults to 0.10 of the examined area."
    },
    {
      "area": "onset regression",
      "id": "D03",
      "justification": "The term is named without a norm. Smooth L1 keeps a linear tail for the late declarations that the persistence requirement can produce.",
      "manuscript_location": "Sec. 5.4, the second objective term",
      "released_behaviour": "Smooth L1 with a half-second transition, applied to the sub-tests that carry a reference onset."
    },
    {
      "area": "objective weights",
      "id": "D04",
      "justification": "The article states that the three terms are combined and does not print the weights.",
      "manuscript_location": "Sec. 5.4",
      "released_behaviour": "Decision 1.0, onset 1.0, repeatability 0.1."
    },
    {
      "area": "optimisation",
      "id": "D05",
      "justification": "No schedule, optimiser, epoch count, batch size or precision is printed. These are released values and are recorded as engineering defaults rather than as manuscript settings.",
      "manuscript_location": "Sec. 5.4",
      "released_behaviour": "AdamW, cosine schedule with linear warm-up, 3e-4, weight decay 1e-2, 40 epochs, batch 8, bf16, gradient clipping at 1.0."
    },
    {
      "area": "operating point",
      "id": "D06",
      "justification": "The article states that the threshold is placed at the weighted specificity limit derived from the two error costs and does not print the costs or the floor.",
      "manuscript_location": "Sec. 2.7",
      "released_behaviour": "The threshold maximises sensitivity subject to a specificity floor of 0.90."
    },
    {
      "area": "structural read-out",
      "id": "D07",
      "justification": "Only the axial resolution is printed; the area needs both pitches.",
      "manuscript_location": "Sec. 5.2",
      "released_behaviour": "Lateral pixel pitch equals the printed axial resolution of 15 micrometres."
    },
    {
      "area": "blink segmentation",
      "id": "D08",
      "justification": "The formal statement takes blink events as given. A released pipeline has to obtain them, and the detector is reported so that a reader can replace it.",
      "manuscript_location": "Sec. 5.6",
      "released_behaviour": "Blinks are detected from a joint contrast collapse and motion spike in the acquisition."
    },
    {
      "area": "sub-test boundary",
      "id": "D09",
      "justification": "Written literally, line 12 assigns the loop variable even when the while condition failed, which would place a declaration one frame beyond the epoch it belongs to.",
      "manuscript_location": "Algorithm 1, lines 9 to 12",
      "released_behaviour": "A sub-test whose loop variable passes the epoch end is recorded as censored, not as a declaration at the boundary frame."
    },
    {
      "area": "decision target",
      "id": "D10",
      "justification": "The term is described over sub-tests. The model reports one decision per acquisition because the clinical endpoint and the comparator table are both clip-level; the per-sub-test labels are used for the onset term.",
      "manuscript_location": "Sec. 5.4, the first objective term",
      "released_behaviour": "The decision is formed once per acquisition from the presence of a reference break-up."
    },
    {
      "area": "fast-branch weights",
      "id": "D11",
      "justification": "The pretrained prior the article describes is a third-party checkpoint that cannot be redistributed here. The ablation row that depends on it is reported BLOCKED rather than approximated.",
      "manuscript_location": "Sec. 5.4",
      "released_behaviour": "No pretrained clip checkpoint is shipped. When one is not supplied the trunk trains jointly with the adapter; when one is supplied the trunk is frozen and only the adapter is fitted."
    }
  ],
